# Copy this file to .env and adjust values.
# NEVER commit your real .env file.

# --- Interactive Brokers connection ---
# TWS Paper Trading default port: 7497   |  TWS Live default port: 7496
# IB Gateway Paper Trading default port: 4002  |  IB Gateway Live default port: 4001
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=17
# Leave empty to use whatever account is active in TWS/Gateway.
IB_ACCOUNT_ID=

# Safety switch. Must be explicitly set to "true" to allow connecting to a LIVE port (7496/4001).
# Keep "false" while testing. The bot refuses to start against a live port unless this is true.
ALLOW_LIVE_TRADING=false

# --- Universe ---
# Simple case: comma separated list of US stock tickers (all routed SMART/USD).
SYMBOLS=AAPL,MSFT,NVDA

# Multi-market case: assign symbols to one or more built-in markets to extend
# trading-hours coverage. Takes priority over SYMBOLS when set. Format:
#   MARKET:sym1,sym2,sym3@EXCHANGE@CURRENCY;MARKET2:sym4,...
# Built-in markets (see src/tradingbot/markets.py for exact session times):
#   US     SMART/USD, includes pre/post-market extended hours (~4:00-20:00 ET)
#   EU     Xetra/EUR by default, 9:00-17:30 CET (override exchange/currency
#          per symbol for other EU exchanges, e.g. VOD@LSE@GBP for London)
#   ASIA   Hong Kong/HKD by default, 9:30-16:00 HKT (override per symbol for
#          e.g. Tokyo: 7203@TSEJ@JPY)
#   CRYPTO PAXOS/USD, genuinely 24/7 including weekends -- still gets a daily
#          synthetic flatten checkpoint (23:55 UTC) to bound risk exposure
# Note: even using all four, this is not true zero-downtime -- every stock
# exchange still closes on weekends, and there's a gap between the US close
# and Asia's next open. Only crypto here trades continuously.
# Example:
# MARKETS=US:AAPL,MSFT,NVDA;EU:SAP,ASML@AEB@EUR;ASIA:700;CRYPTO:BTC,ETH
MARKETS=

# --- Strategy parameters (EMA/RSI/VWAP intraday momentum) ---
BAR_SIZE=5 mins
EMA_FAST=9
EMA_SLOW=21
RSI_PERIOD=14
RSI_LONG_MIN=50
RSI_LONG_MAX=70
RSI_SHORT_MIN=30
RSI_SHORT_MAX=50
ATR_PERIOD=14
STOP_ATR_MULT=1.5
TARGET_ATR_MULT=2.5
ALLOW_SHORTING=false

# --- Risk management ---
# % of account net liquidation value risked per single trade (stop distance based).
RISK_PER_TRADE_PCT=0.5
# Hard daily loss limit as % of account net liquidation value. Bot stops opening new trades
# and flattens all positions once breached.
MAX_DAILY_LOSS_PCT=2.0
MAX_CONCURRENT_POSITIONS=3
# Max % of account equity allocated to a single position's notional value.
MAX_POSITION_PCT=20

# --- Trading hours ---
# Each market's own session times come from the built-in presets (see
# src/tradingbot/markets.py) -- not configurable here. These buffer minutes
# apply the same way to every market's own close/daily checkpoint.
# Stop opening new positions this many minutes before a market's close.
NO_NEW_ENTRIES_BEFORE_CLOSE_MIN=15
# Flatten that market's positions this many minutes before its close.
FLATTEN_BEFORE_CLOSE_MIN=5

LOG_LEVEL=INFO
LOG_DIR=logs

# --- News sentiment shadow-trading (observation only, NEVER places real orders) ---
# When enabled, polls Finnhub for news per symbol, has Claude assess each new
# article's likely price impact, and if confident enough, simulates a
# hypothetical trade (same ATR stop/target rules as the real strategy) purely
# to log whether the call would have been right. See DOCS for cost caveats:
# this makes real Finnhub + Anthropic API calls.
ENABLE_NEWS_MONITOR=false
FINNHUB_API_KEY=
ANTHROPIC_API_KEY=
NEWS_MODEL=claude-haiku-4-5-20251001
# Minimum model confidence (0-1) required to open a shadow trade.
NEWS_CONFIDENCE_THRESHOLD=0.6
# How often (seconds) to actually poll for new articles (keep this well above
# a few minutes to respect free-tier API rate limits and cost).
NEWS_POLL_INTERVAL_SEC=300
# Force-close a shadow trade after this many minutes even if neither the
# stop nor the target was hit.
NEWS_MAX_HOLD_MIN=240
