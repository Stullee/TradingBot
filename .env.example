# Copy this file to .env and adjust values.
# NEVER commit your real .env file.

# --- Interactive Brokers connection ---
# TWS Paper Trading default port: 7497   |  TWS Live default port: 7496
# IB Gateway Paper Trading default port: 4002  |  IB Gateway Live default port: 4001
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=17
# Leave empty to use whatever account is active in TWS/Gateway.
IB_ACCOUNT_ID=

# Safety switch. Must be explicitly set to "true" to allow connecting to a LIVE port (7496/4001).
# Keep "false" while testing. The bot refuses to start against a live port unless this is true.
ALLOW_LIVE_TRADING=false

# --- Universe ---
# Simple case: comma separated list of US stock tickers (all routed SMART/USD).
SYMBOLS=AAPL,MSFT,NVDA

# Multi-market case: assign symbols to one or more built-in markets to extend
# trading-hours coverage. Takes priority over SYMBOLS when set. Format:
#   MARKET:sym1,sym2,sym3@EXCHANGE@CURRENCY;MARKET2:sym4,...
# Built-in markets (see src/tradingbot/markets.py for exact session times).
# Stock markets are holiday/early-close aware via exchange calendars
# (pandas_market_calendars), so half-days flatten before the real close:
#   US     SMART/USD, regular trading hours only (9:30-16:00 ET, NYSE calendar)
#   EU     Xetra/EUR by default, 9:00-17:30 CET (override exchange/currency
#          per symbol for other EU exchanges, e.g. VOD@LSE@GBP for London)
#   ASIA   Hong Kong/HKD by default, 9:30-16:00 HKT (override per symbol for
#          e.g. Tokyo: 7203@TSEJ@JPY)
#   CRYPTO PAXOS/USD, genuinely 24/7 including weekends -- still gets a daily
#          synthetic flatten checkpoint (23:55 UTC) to bound risk exposure.
#          Sized fractionally (e.g. 0.004 BTC) using IB's own size increments.
# Note: even using all four, this is not true zero-downtime -- every stock
# exchange still closes on weekends, and there's a gap between the US close
# and Asia's next open. Only crypto here trades continuously.
# Example:
# MARKETS=US:AAPL,MSFT,NVDA;EU:SAP,ASML@AEB@EUR;ASIA:700;CRYPTO:BTC,ETH
MARKETS=

# --- Strategy ---
# "vwap_mean_reversion" (default): fades price back toward VWAP on oversold/
#   overbought extremes -- fires often, many small trades a day, best suited
#   to range-bound/choppy conditions (most of a session).
# "ema_rsi_momentum": trend-following EMA crossover -- fires rarely (only at
#   genuine trend turns), bigger average win, needs a real trend to happen.
STRATEGY=vwap_mean_reversion
BAR_SIZE=5 mins
EMA_FAST=9
EMA_SLOW=21
RSI_PERIOD=14
# Used by ema_rsi_momentum only:
RSI_LONG_MIN=50
RSI_LONG_MAX=70
RSI_SHORT_MIN=30
RSI_SHORT_MAX=50
# Used by vwap_mean_reversion only:
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70
# How far price must have drifted from VWAP (in ATR multiples) to trigger a
# mean-reversion entry. Lower = more trades but weaker/noisier setups.
VWAP_DIST_ATR_MULT=0.5
# Trend filter for vwap_mean_reversion (ignored by ema_rsi_momentum): blocks
# LONG entries while price is below this EMA (a downtrend) and SHORT entries
# while price is above it (an uptrend) -- keeps the "buy dips / sell rips"
# mean-reversion timing but only with the prevailing trend, not against it.
# Set to 0 to disable (old unconditional countertrend behavior).
TREND_EMA_PERIOD=50
ATR_PERIOD=14
STOP_ATR_MULT=1.5
TARGET_ATR_MULT=2.5
ALLOW_SHORTING=false

# --- Risk management ---
# % of account net liquidation value risked per single trade (stop distance based).
RISK_PER_TRADE_PCT=0.5
# Hard daily loss limit as % of account net liquidation value. Bot stops opening new trades
# and flattens all positions once breached. Baselines and tripped kill
# switches persist across restarts (logs/risk_state.json) -- a restart never
# grants a fresh loss budget.
MAX_DAILY_LOSS_PCT=2.0
# Weekly drawdown breaker: % loss since the ISO week's starting equity that
# halts trading until the next week. Catches "lose the daily limit every
# day" -- five straight -2% days never trip a daily limit. 0 disables.
MAX_WEEKLY_LOSS_PCT=5.0
MAX_CONCURRENT_POSITIONS=10
# Max % of account equity allocated to a single position's notional value.
MAX_POSITION_PCT=20
# Portfolio heat cap: total entry-to-stop risk across all open positions as
# % of equity. 10 concurrent positions x 0.5% each = 5% of equity at risk at
# once (usually correlated); this bounds the sum directly. 0 disables.
MAX_OPEN_RISK_PCT=3.0

# --- Trading hours ---
# Each market's own session times come from the built-in presets (see
# src/tradingbot/markets.py) -- not configurable here. These buffer minutes
# apply the same way to every market's own close/daily checkpoint.
# Stop opening new positions this many minutes before a market's close.
NO_NEW_ENTRIES_BEFORE_CLOSE_MIN=15
# Flatten that market's positions this many minutes before its close.
FLATTEN_BEFORE_CLOSE_MIN=5
# No entries during the first N minutes after a market's open (opening
# auction volatility, unsettled ATR/VWAP). Exits still work. 0 disables.
NO_ENTRIES_AFTER_OPEN_MIN=15

LOG_LEVEL=INFO
LOG_DIR=logs

# --- Alerting ---
# Optional webhook POSTed ({"title","message","key","timestamp"}) on events
# needing prompt attention: kill switch trips, a position found without its
# stop-loss, critical order rejections, an AI-advisor CRITICAL call. Works
# with a Home Assistant webhook trigger, ntfy.sh, etc. Empty disables.
ALERT_WEBHOOK_URL=

# --- Live status dashboard ---
# Read-only web dashboard (equity, positions, P&L, news/shadow-trading
# stats) running alongside the engine in the same process. Auto-refreshes
# every 5s. Never places orders.
ENABLE_DASHBOARD=true
DASHBOARD_PORT=8099

# --- Backtesting (python -m tradingbot.backtest.runner) ---
# IB duration string for how far back to pull historical bars, e.g. "30 D",
# "6 M", "1 Y". Uses the same SYMBOLS/MARKETS/STRATEGY config as live trading.
BACKTEST_DURATION=60 D
# Cost model, so backtest expectancy isn't fiction: commission per share per
# side (IB fixed US pricing: $0.005/share) and slippage in basis points
# applied adversely to every simulated market-order fill. Entries also fill
# at the NEXT bar's open (as live orders actually do), not the signal bar's
# close. Set both to 0 to see the frictionless fantasy number.
BACKTEST_COMMISSION_PER_SHARE=0.005
BACKTEST_SLIPPAGE_BPS=1.0

# --- News sentiment shadow-trading (observation only, NEVER places real orders) ---
# When enabled, polls Finnhub for news per symbol, has Claude assess each new
# article's likely price impact, and if confident enough, simulates a
# hypothetical trade (same ATR stop/target rules as the real strategy) purely
# to log whether the call would have been right. See DOCS for cost caveats:
# this makes real Finnhub + Anthropic API calls.
ENABLE_NEWS_MONITOR=false
FINNHUB_API_KEY=
ANTHROPIC_API_KEY=
NEWS_MODEL=claude-haiku-4-5-20251001
# Minimum model confidence (0-1) required to open a shadow trade.
NEWS_CONFIDENCE_THRESHOLD=0.6
# How often (seconds) to actually poll for new articles (keep this well above
# a few minutes to respect free-tier API rate limits and cost).
NEWS_POLL_INTERVAL_SEC=300
# Force-close a shadow trade after this many minutes even if neither the
# stop nor the target was hit.
NEWS_MAX_HOLD_MIN=240

# --- AI advisor (observation/advice only, NEVER places or changes orders) ---
# Periodic Claude-based supervisory analysis of the real-trade journal,
# shadow results and risk state: is the bot actually making money, what's
# bleeding, what to change. Shown on the dashboard and in the CLI report;
# a CRITICAL health call also fires ALERT_WEBHOOK_URL. Requires
# ANTHROPIC_API_KEY. One API call per interval.
ENABLE_AI_ADVISOR=false
ADVISOR_MODEL=claude-sonnet-5
ADVISOR_INTERVAL_MIN=60
