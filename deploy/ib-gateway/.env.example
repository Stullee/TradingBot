# Copy to .env in this same directory before running `docker compose up -d`.
# NEVER commit your real .env file.

TWS_USERID=your_ib_paper_username
TWS_PASSWORD=your_ib_paper_password

# paper | live | both
TRADING_MODE=paper

# no | yes -- keep "no" so the bot can actually place orders.
READ_ONLY_API=no

TIME_ZONE=America/New_York

# What IB Gateway does if a 2FA prompt on your phone isn't confirmed in time.
TWOFA_TIMEOUT_ACTION=restart

# Optional: e.g. "11:59 PM" to restart IB Gateway daily (IB requires a
# periodic restart; leave empty to pick IB's own default schedule).
AUTO_RESTART_TIME=

# Optional: set a password to enable a VNC server on port 5900, useful for
# watching the first login / approving 2FA manually. Leave empty to disable.
VNC_SERVER_PASSWORD=
